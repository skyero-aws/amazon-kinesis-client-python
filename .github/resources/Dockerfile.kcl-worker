# TEMP CI: KCL worker image for CPU-based lease balancing tests.
# Build from the repo root after `python setup.py download_jars` so the jars are in the build context.
FROM python:3.9-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY . /kclpy
WORKDIR /kclpy
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -e .
